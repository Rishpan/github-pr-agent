# Gemini (default) — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Smaller default — 70b-versatile hits TPM limits quickly on multi-step runs
GROQ_MODEL=llama-3.1-8b-instant

# "groq" or omit for Gemini
LLM_PROVIDER=

# Tool loop cap (default 8)
# AGENT_MAX_STEPS=8
# LLM retries: default 1 for Gemini (free tier ~10–20 RPM), 6 for Groq TPM
# AGENT_MAX_RETRIES=1
# Pause once and retry the whole generateText call after a 429 (default 65000 ms)
# AGENT_RATE_LIMIT_WAIT_MS=65000
