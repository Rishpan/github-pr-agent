# GitHub (optional for public repos; improves rate limits on get_file/list_files)
GITHUB_TOKEN=

# Bot account PAT for fork_repo (forks land on this account, not GITHUB_TOKEN's user)
GITHUB_BOT_TOKEN=

# RAG / semantic_search / index_repo (same as rag/.env.example)
CHROMA_HOST=
CHROMA_PORT=
OLLAMA_HOST=
OLLAMA_PORT=
OLLAMA_EMBED_MODEL=
