CHROMA_HOST=localhost
CHROMA_PORT=8000

OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: override local clone cache (default: {tmpdir}/github-pr-agent)
# GITHUB_PR_AGENT_CLONE_CACHE=C:/path/to/clone-cache

# Semantic search tuning (optional)
# RAG_MIN_SIMILARITY=0.45
# RAG_RELATIVE_CUTOFF_DELTA=0.08
# RAG_OVER_FETCH_MULTIPLIER=3
# RAG_MAX_OVER_FETCH=50
# RAG_SOURCE_PATH_BOOST=0.04
# RAG_TEST_PATH_PENALTY=0.04

# Uncomment for Chroma Cloud:
# CHROMA_API_KEY=your-key
# CHROMA_TENANT=your-tenant
# CHROMA_DATABASE=your-db
